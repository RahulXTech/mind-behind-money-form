# Set these in your host's Environment Variables (Hostinger Node.js app or Vercel). Never commit real values.
# For local runs, copy this file to server/.env (git-ignored) and fill it in.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret: the value you type when creating the webhook in Razorpay (Account & Settings → Webhooks).
# A separate credential — it must NOT be the same as RAZORPAY_KEY_SECRET (the server refuses that).
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mindbehindmoney
ALLOWED_ORIGINS=https://consult.axamp.com,https://axamp.com,https://www.axamp.com,http://localhost:5173
# Optional: how long to wait for Razorpay's API, in milliseconds (default 10000)
RAZORPAY_TIMEOUT_MS=10000
